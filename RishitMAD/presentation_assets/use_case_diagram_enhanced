// Use Case Diagram
digraph use_case {
	graph [fontcolor="#2D3436" fontname=Helvetica fontsize=20 nodesep=0.8 pad=1 ranksep=1 splines=ortho]
	node [color="#B2BEC3" fillcolor="#FFFFFF" fontname=Helvetica fontsize=14 shape=record style="rounded,filled"]
	edge [arrowsize=0.8 color="#636E72" fontname=Helvetica fontsize=12]
	label="Use Case Diagram" labelloc=t rankdir=TB
	{
		rank=source
		Admin [label=Admin fillcolor="#DFF9FB" shape=egg]
		Doctor [label=Doctor fillcolor="#DFF9FB" shape=egg]
		Patient [label=Patient fillcolor="#DFF9FB" shape=egg]
	}
	subgraph cluster_system {
		color=grey label="Hospital Management System" style="rounded,dashed"
		node [fillcolor="#E0E0E0" shape=ellipse style=filled]
		UC_MANAGE_USERS [label="Manage Users & Depts."]
		UC_ANALYTICS [label="View Analytics"]
		UC_MANAGE_AVAIL [label="Manage Availability"]
		UC_UPDATE_HISTORY [label="Update Patient Records"]
		UC_VIEW_HISTORY [label="View Medical History"]
		UC_BOOK_APPT [label="Book / Cancel Appointments"]
		UC_SEARCH [label="Search & View Doctors"]
		UC_MANAGE_PROFILE [label="Manage Profile"]
		UC_LOGIN [label=Login]
	}
	Admin -> UC_MANAGE_USERS
	Admin -> UC_ANALYTICS
	Admin -> UC_LOGIN
	Doctor -> UC_MANAGE_AVAIL
	Doctor -> UC_UPDATE_HISTORY
	Doctor -> UC_VIEW_HISTORY
	Doctor -> UC_LOGIN
	Patient -> UC_MANAGE_PROFILE
	Patient -> UC_SEARCH
	Patient -> UC_BOOK_APPT
	Patient -> UC_VIEW_HISTORY
	Patient -> UC_LOGIN
	UC_BOOK_APPT -> UC_SEARCH [label=<<include>> arrowhead=open style=dashed]
}
